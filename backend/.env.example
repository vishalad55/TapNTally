# ---- Runtime ----
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed by CORS (mobile dev client + web tooling)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- Database ----
# "sqljs" = zero-install local file DB (dev/demo). "postgres" = production.
DB_DRIVER=sqljs
DB_SQLJS_FILE=./data/tapntally.sqlite
# Used when DB_DRIVER=postgres
DATABASE_URL=postgres://tapntally:tapntally@localhost:5432/tapntally
# Auto-create schema. Only ever true for sqljs/dev. Production uses migrations.
DB_SYNCHRONIZE=true

# ---- Auth ----
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Google OAuth client IDs (web client id is what ID tokens are minted for)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allow POST /auth/dev to sign in as a seeded user without Google. NEVER true in prod.
AUTH_DEV_LOGIN=true

# ---- Encryption at rest (OAuth tokens, terminal secrets) ----
# Exactly 32 bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktY2hhbmdlLW1lISE=

# ---- NFC / POS ----
# When true, bills from terminals that aren't enrolled or fail HMAC are rejected.
NFC_REQUIRE_SIGNATURE=false

# ---- Queue ----
# Leave empty for the in-process queue (dev). Set to use BullMQ.
REDIS_URL=

# ---- Gmail sync ----
# Pub/Sub topic for Gmail push notifications (users.watch). Leave empty to use polling only.
GMAIL_PUBSUB_TOPIC=
# Shared secret the Pub/Sub push subscription sends as ?token=
GMAIL_WEBHOOK_TOKEN=
# How far back the first-time backfill looks.
GMAIL_BACKFILL_DAYS=180

# ---- Push notifications ----
# Path to a Firebase service-account JSON. Leave empty to log pushes to stdout.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Internal / partner APIs ----
# Required as X-Internal-Key for /internal/* (analytics, terminal enrolment).
INTERNAL_API_KEY=dev-internal-key
