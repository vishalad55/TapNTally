{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix .. install --no-audit --no-fund",
  "buildCommand": "npm --prefix .. run build --workspace @tapntally/shared && npx nest build && cp ../node_modules/sql.js/dist/sql-wasm.wasm dist/",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 30, "memory": 1024, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
